# Copy to `.env` and adjust for local development.

PORT=3000
JWT_SECRET=change-me
CONNECTOR_JWT_SECRET=

# MySQL (Sequelize)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=syncly_db
DB_USER=root
DB_PASSWORD=
# Set true once after schema changes so Sequelize can ALTER tables (dev only).
DB_SYNC_ALTER=false

# Sync worker: interval fallback when Bull is off
SYNC_WORKER_INTERVAL_MS=3000

# Optional: BullMQ + Redis for sync jobs (retries/backoff). Falls back to interval poller if unset/false.
SYNC_USE_BULL=false
SYNC_BULL_LOG=false
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Email / campaigns (optional)
RESEND_API_KEY=
RESEND_FROM=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
EMAIL_WORKER_INTERVAL_MS=5000

# Billing (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EXTREME=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=

# Mobile OAuth (optional)
GOOGLE_CLIENT_ID=

# Push (optional)
EXPO_ACCESS_TOKEN=

# Inventory alerts
LOW_STOCK_THRESHOLD=10
