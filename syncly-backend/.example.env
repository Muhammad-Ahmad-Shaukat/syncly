# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=3000

# --- MySQL (Sequelize) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=syncly_db
DB_USER=root
DB_PASSWORD=

# Set to "true" once in dev when adding/changing models (applies Sequelize alter).
DB_SYNC_ALTER=false

# --- Auth (required for users + mobile + connector tokens) ---
JWT_SECRET=change-me-to-a-long-random-string

# Optional: separate secret for Woo/Shopify connector JWTs (defaults to JWT_SECRET).
CONNECTOR_JWT_SECRET=
CONNECTOR_ACCESS_TTL_SECONDS=3600
CONNECTOR_REFRESH_TTL_SECONDS=2592000

# --- Google Sign-In (mobile /api/mobile/auth/google) ---
# Web client ID from Google Cloud Console; used to validate id_token audience.
GOOGLE_CLIENT_ID=

# --- Stripe (billing + webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EXTREME=
STRIPE_SUCCESS_URL=http://127.0.0.1:8081/
STRIPE_CANCEL_URL=http://127.0.0.1:8081/
STRIPE_PORTAL_RETURN_URL=http://127.0.0.1:8081/

# --- Email (campaign worker; Resend preferred, else SendGrid) ---
RESEND_API_KEY=
RESEND_FROM=InventSync <onboarding@resend.dev>
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# --- Expo push (optional; higher Expo API limits) ---
EXPO_ACCESS_TOKEN=

# --- InventSync thresholds & workers ---
LOW_STOCK_THRESHOLD=10
SYNC_WORKER_INTERVAL_MS=3000
EMAIL_WORKER_INTERVAL_MS=5000
