# Copy to .env (Expo loads EXPO_PUBLIC_* at build/start). Do not commit .env with secrets.

# Backend origin only — no trailing slash, no /api suffix.
# Examples:
#   Android emulator → http://10.0.2.2:3000
#   iOS simulator / same machine → http://127.0.0.1:3000
#   Physical device / tunnel → https://your-ngrok-subdomain.ngrok-free.app
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Legacy alias still read by config/api.js if EXPO_PUBLIC_API_URL is unset.
# FRONTEND_URL=http://127.0.0.1:3000

# Optional — enables "Continue with Google" on Login (must match Google Cloud OAuth client).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
